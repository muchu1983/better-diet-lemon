Screen.list-screen{
	align: center middle;
	background: cyan;
	color: red;
}

Horizontal{
	background: transparent;
}

VerticalScroll.left-panel{
	width: 1fr;
}

VerticalScroll.right-panel{
	width: 3fr;
}

Static.left-panel{
	background: green;
	width: 1fr;
	height: 3;
	border: solid red;
}

Static.right-panel{
	background: yellow;
	width: 1fr;
}