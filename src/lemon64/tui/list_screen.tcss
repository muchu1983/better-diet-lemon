Screen.list-screen{
	align: center middle;
	background: cyan;
	color: skyblue;
}

Horizontal{
	background: transparent;
}

VerticalScroll.left-panel{
	width: 1fr;
}

VerticalScroll.right-panel{
	width: 3fr;
}

PersonStatic#myself{
	layout: horizontal;
	background: mediumpurple;
	height: 3;
	border: solid red;
}

PersonStatic.someone{
	layout: horizontal;
	background: green;
	height: 3;
	border: solid red;
}

Button.publish-to-map{
	padding: 0;
	margin: 0;
	border: none;
	min-height: 1;
	min-width: 2;
	background: yellow;
	color: blue;
}

Static.right-panel{
	background: yellow;
	width: 1fr;
}